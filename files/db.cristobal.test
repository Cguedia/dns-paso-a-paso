;
; cristobal.test
;
$TTL	604800
@	IN	SOA	debian.cristobal.test. admin.cristobal.test. (
			      2		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
@	IN	NS	debian.cristobal.test.
debian.cristobal.test.	IN	A	192.168.56.10
ftp     IN  CNAME   www.cristobal.test.
@       IN  TXT     "Servidor DNS de Cristobal"
