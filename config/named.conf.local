// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

zone "cristobal.test" {
    type master;
    file "/etc/bind/db.cristobal.test";
};

zone "56.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/cristobal.test.rev";
};
